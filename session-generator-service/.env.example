# ==============================================================================
# Telegram Session Generator Service Configuration
# ==============================================================================

# Telegram MTProto API Credentials (obtain from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Web Server Port
PORT=5000

# Session In-Memory Expiration (minutes)
SESSION_TTL_MINUTES=10

# Telethon Network Timeout and Retry Limits
TELETHON_TIMEOUT_SECONDS=15
TELETHON_CONNECTION_RETRIES=2
