# ==============================================================================
# Telegram Relay Userbot Configuration
# ==============================================================================

# Telegram MTProto API Credentials (obtain from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telethon StringSession (generate once via session-generator-service)
# REQUIRED: Must be set on production/container environments
SESSION_STRING=your_string_session_here

# Local session name (optional fallback if file session is used)
SESSION_NAME=telegram_userbot

# SQLite Database path for message persistence and queue tracking
DB_PATH=relay_queue.db

# Routing Configuration
# SOURCE_CHANNELS: comma-separated list of usernames or channel IDs to monitor
SOURCE_CHANNELS=@source_channel_1,@source_channel_2

# TARGET_CHAT: username or ID of the staging chat or intake bot
TARGET_CHAT=@intake_bot

# Queue & Relay Settings
# DELAY_MINUTES: dispatch delay (0 for immediate)
DELAY_MINUTES=0

# RELAY_MODE: 'copy' (re-sends content cleanly) or 'forward' (standard Telegram forward)
RELAY_MODE=copy

# Human-like Rate Limiting & Anti-Ban Settings
SEND_DELAY_MIN_SECONDS=1.5
SEND_DELAY_MAX_SECONDS=4.5
POLL_INTERVAL_SECONDS=5
ALBUM_WAIT_SECONDS=5

# Reliability Settings
MAX_DELIVERY_RETRIES=3
CONNECTION_RETRIES=10
RETRY_DELAY_SECONDS=5
JOURNAL_MODE=WAL
LOG_TO_FILE=1
LOG_FILE_PATH=userbot.log
LOG_LEVEL=INFO

# Optional Health Check Port for Cloud PaaS (Render, Railway, etc.)
PORT=8080
