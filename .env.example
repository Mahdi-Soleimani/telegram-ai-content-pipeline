# ==============================================================================
# Telegram AI Content Pipeline - Root Environment Configuration
# ==============================================================================

# --- Telegram API Credentials (from https://my.telegram.org) ---
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# --- Relay Userbot Settings ---
SESSION_STRING=your_telethon_string_session_here
SOURCE_CHANNELS=@source_channel_1,@source_channel_2
TARGET_CHAT=@content_intake_bot
RELAY_MODE=copy
DELAY_MINUTES=0

# --- Telegram Bot & Channel ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_CHAT_ID=123456789
TARGET_CHANNEL_ID=-1001234567890
CHANNEL_SIGNATURE=━━━━━━━━━━━━━━\n📢 Official Crypto Channel\n🆔 @YourChannel

# --- AI LLM API Keys ---
# For Gemini / DeepSeek / OpenAI models configured in n8n
OPENAI_API_KEY=your_llm_api_key_here

# --- n8n Workflow Automation Engine ---
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
# Allow n8n workflow expressions to access environment variables via $env
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Session Generator Service ---
SESSION_GEN_PORT=5000
